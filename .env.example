# Server
NODE_ENV=development
PORT=3000

# Database
# Prefer SQLITE_DB_PATH for local development.
SQLITE_DB_PATH=./data/app.db
# DATABASE_URL=file:./data/app.db

# Logging
LOG_LEVEL=log

# CORS
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Auth (must be at least 32 chars)
JWT_ACCESS_SECRET=replace-with-a-32+char-secret________________
JWT_REFRESH_SECRET=replace-with-a-32+char-secret________________
ACCESS_TOKEN_TTL=600000
REFRESH_TOKEN_TTL=2592000000

# Cookies (optional)
# COOKIE_DOMAIN=example.com

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...

# Telegram polling (optional)
TELEGRAM_POLL_INTERVAL_MS=5000
TELEGRAM_POLL_LIMIT=25
TELEGRAM_POLL_TIMEOUT_SECONDS=0

# Gemini API key
GEMINI_API_KEY=replace-with-a-gemini-api-key